<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neumorphic Hyperliquid Dashboard</title>
    <style>
        :root {
            --bg-color: #262a33;
            --shadow-dark: #1d2027;
            --shadow-light: #2f343f;
            --text-main: #e0e6ed;
            --text-muted: #8c93a1;
            --green: #00d26a;
            --red: #f6465d;
            --gold: #f7a600;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 20px;
            min-width: 1200px; 
        }
        
        .container {
            width: 100%;
            margin: 0 auto;
        }

        /* --- ВЕРХНЯЯ ПАНЕЛЬ С КНОПКОЙ --- */
        .action-bar {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 20px;
        }

        .neumorphic-btn {
            background: var(--bg-color);
            border: none;
            color: var(--text-muted);
            padding: 12px 24px;
            border-radius: 12px;
            box-shadow: 6px 6px 12px var(--shadow-dark), -6px -6px 12px var(--shadow-light);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 14px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.2s ease;
            outline: none;
        }
        
        .neumorphic-btn:active, .neumorphic-btn.active {
            box-shadow: inset 4px 4px 8px var(--shadow-dark), inset -4px -4px 8px var(--shadow-light);
            color: var(--gold);
        }

        .neumorphic-btn svg {
            width: 20px;
            height: 20px;
            fill: currentColor;
        }

        .neumorphic {
            background: var(--bg-color);
            border-radius: 16px;
            box-shadow: 8px 8px 16px var(--shadow-dark), -8px -8px 16px var(--shadow-light);
        }
        
        .neumorphic-inset {
            background: var(--bg-color);
            border-radius: 12px;
            box-shadow: inset 6px 6px 12px var(--shadow-dark), inset -6px -6px 12px var(--shadow-light);
        }

        /* --- ВЕРХНИЙ ДАШБОРД --- */
        .top-dashboard {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
        }
        .main-balance-card, .potential-balance-card {
            flex: 1;
            padding: 25px 20px;
            text-align: center;
        }
        
        .top-title {
            color: var(--text-muted);
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 10px;
            font-weight: 600;
        }
        .top-value {
            font-size: 40px;
            font-weight: bold;
            color: var(--text-main);
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }
        .potential-value { color: var(--gold); }

        .drawdown-badge {
            margin-top: 10px;
            display: inline-block;
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            color: var(--red);
            background: var(--bg-color);
            box-shadow: 4px 4px 10px var(--shadow-dark), -4px -4px 10px var(--shadow-light);
        }

        /* Структура внутри карточки "Потенциальный баланс" */
        .potential-card-inner {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 40px;
            margin-top: 5px;
        }
        .potential-main {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .potential-exposure {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .exposure-badge {
            padding: 8px 16px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: bold;
            background: var(--bg-color);
            box-shadow: 4px 4px 8px var(--shadow-dark), -4px -4px 8px var(--shadow-light);
            display: flex;
            justify-content: space-between;
            min-width: 140px;
            align-items: center;
        }
        .exposure-badge span {
            margin-left: 15px;
            font-size: 14px;
        }
        .long-exposure { border-left: 4px solid var(--green); color: var(--text-main); }
        .long-exposure span { color: var(--green); }
        .short-exposure { border-left: 4px solid var(--red); color: var(--text-main); }
        .short-exposure span { color: var(--red); }

        /* --- СЕТКА ДЛЯ 8 КОЛОНОК --- */
        .wallets-container {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            gap: 15px;
            align-items: start; 
        }
        
        .wallet-card {
            display: flex;
            flex-direction: column;
            padding: 15px 10px;
            transition: height 0.4s ease;
        }

        .wallet-info { text-align: center; margin-bottom: 15px; }
        .wallet-name {
            font-size: 16px;
            font-weight: bold;
            color: var(--text-main);
            letter-spacing: 0.5px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .wallet-address { font-size: 11px; color: var(--text-muted); margin-top: 4px; }
        .wallet-balance { font-size: 22px; font-weight: bold; color: var(--text-main); margin-top: 10px; }

        .divider {
            width: 100%;
            height: 2px;
            background: var(--bg-color);
            box-shadow: inset 1px 1px 3px var(--shadow-dark), inset -1px -1px 3px var(--shadow-light);
            border-radius: 2px;
            margin-bottom: 15px;
            flex-shrink: 0;
        }

        .wallet-positions {
            padding: 10px;
            flex-grow: 1; 
            display: flex;
            flex-direction: column;
        }

        table { width: 100%; border-collapse: collapse; font-size: 12px; }
        th {
            color: var(--text-muted);
            font-weight: normal;
            font-size: 11px;
            padding-bottom: 8px;
            border-bottom: 2px solid var(--shadow-dark);
            text-align: left;
        }
        td {
            padding: 8px 2px;
            text-align: left;
            border-bottom: 1px solid rgba(29, 32, 39, 0.5);
        }
        tr:last-child td { border-bottom: none; }
        
        .pnl-green { color: var(--green); font-weight: bold;}
        .pnl-red { color: var(--red); font-weight: bold;}
        .no-positions { color: var(--text-muted); text-align: center; font-style: italic; font-size: 11px; padding: 15px 0;}

        /* СТРЕЛКИ НАПРАВЛЕНИЯ ПОЗИЦИЙ */
        .direction-header { width: 20px; text-align: center; } 
        table tr td.direction-cell { padding: 4px 0; width: 20px; text-align: center; } 
        .direction-icon { width: 14px; height: 14px; vertical-align: middle; } 
        .long-icon { fill: var(--green); } 
        .short-icon { fill: var(--red); } 

        /* --- НИЖНИЙ БЛОК: КУРСЫ ВАЛЮТ --- */
        .prices-bar {
            margin-top: 30px;
            padding: 25px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .prices-wrapper {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            justify-content: center;
            width: 100%;
        }
        .price-pill {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 20px;
        }
        .price-coin {
            color: var(--text-muted);
            font-weight: bold;
            font-size: 14px;
            letter-spacing: 1px;
        }
        .price-value {
            color: var(--text-main);
            font-weight: bold;
            font-size: 16px;
        }

    </style>
</head>
<body>

<div class="container">
    
    <div class="action-bar">
        <button class="neumorphic-btn" id="toggle-balance-btn" onclick="toggleBalances()">
            <svg stroke="currentColor" xml:space="preserve" viewBox="0 0 80 80" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg" version="1.1">
                <g stroke-width="0"></g>
                <g stroke-linejoin="round" stroke-linecap="round"></g>
                <g> <path d="M64,48L64,48h-8V32h8c8.836,0,16-7.164,16-16S72.836,0,64,0c-8.837,0-16,7.164-16,16v8H32v-8c0-8.836-7.164-16-16-16 S0,7.164,0,16s7.164,16,16,16h8v16h-8l0,0l0,0C7.164,48,0,55.164,0,64s7.164,16,16,16c8.837,0,16-7.164,16-16l0,0v-8h16v7.98 c0,0.008-0.001,0.014-0.001,0.02c0,8.836,7.164,16,16,16s16-7.164,16-16S72.836,48.002,64,48z M64,8c4.418,0,8,3.582,8,8 s-3.582,8-8,8h-8v-8C56,11.582,59.582,8,64,8z M8,16c0-4.418,3.582-8,8-8s8,3.582,8,8v8h-8C11.582,24,8,20.417,8,16z M16,72 c-4.418,0-8-3.582-8-8s3.582-8,8-8l0,0h8v8C24,68.418,20.418,72,16,72z M32,48V32h16v16H32z M64,72c-4.418,0-8-3.582-8-8l0,0v-8 h7.999c4.418,0,8,3.582,8,8S68.418,72,64,72z"></path> </g>
            </svg>
            <span id="btn-text">Скрыть баланс</span>
        </button>
    </div>

    <div class="top-dashboard">
        <div class="main-balance-card neumorphic">
            <div class="top-title">ТЕКУЩИЙ КАПИТАЛ (8 АККАУНТОВ)</div>
            <div class="top-value" id="grand-total">$0.00</div>
        </div>

        <div class="potential-balance-card neumorphic-inset">
            <div class="top-title">ПОТЕНЦИАЛЬНЫЙ БАЛАНС (ПРИ Б.У.)</div>
            
            <div class="potential-card-inner">
                <div class="potential-main">
                    <div class="top-value potential-value" id="potential-total">$0.00</div>
                    <div class="drawdown-badge" id="drawdown-sum">Сумма минусов: $0.00</div>
                </div>
                
                <div class="potential-exposure">
                    <div class="exposure-badge long-exposure">Лонги: <span id="total-long-value">$0.00</span></div>
                    <div class="exposure-badge short-exposure">Шорты: <span id="total-short-value">$0.00</span></div>
                </div>
            </div>
            
        </div>
    </div>

    <div class="wallets-container" id="wallets-container"></div>

    <div class="prices-bar neumorphic" id="prices-bar">
        <div class="top-title" style="margin-bottom: 20px;">ТЕКУЩИЕ КУРСЫ ОТКРЫТЫХ АКТИВОВ</div>
        <div class="prices-wrapper" id="prices-container">
            <span class="no-positions">Загрузка курсов...</span>
        </div>
    </div>

</div>

<script>
    const accounts = [
        { name: "Buy high sell low", address: "0x2c9548f036dc25b7184118d7222bd61f1692c3b8" },
        { name: "Antiniohol", address: "0xdd4cdd5798a5b261fb9e45403a0d8b2e3d5cf649" },
        { name: "5951111", address: "0x63c91e6d2b2b052a1dc0ee995222063146121d62" },
        { name: "Ireal", address: "0xbc5cafd831501be517d3766cfca7638ccda41932" },
        { name: "5950101", address: "0xa3d021295c30313b069d96c2c68390a61dbe6797" },
        { name: "Life782", address: "0xf2a2728428bd9efa0dc5de87b6d8d5a27a510061" },
        { name: "1542408", address: "0xf3bff980d9e3e3614861be3e9f332d03a8560bf6" },
        { name: "DVV21", address: "0x7797859d864f621041a0257d3d7ee99f0027d8a8" } 
    ];

    // Словарь рейтингов капитализации
    const mktCapRanks = {
        "BTC": 1, "ETH": 2, "BNB": 3, "SOL": 4, "XRP": 5, "DOGE": 6, "ADA": 7, 
        "AVAX": 8, "SHIB": 9, "TON": 10, "DOT": 11, "TRX": 12, "LINK": 13, 
        "BCH": 14, "NEAR": 15, "MATIC": 16, "LTC": 17, "ICP": 18, "UNI": 19, 
        "APT": 20, "PEPE": 21, "STX": 22, "FIL": 23, "ATOM": 24, "ARB": 25, 
        "RNDR": 26, "IMX": 27, "OP": 28, "INJ": 29, "TIA": 30, "WIF": 31, 
        "SUI": 32, "KAS": 33, "ORDI": 34, "SEI": 35, "FET": 36, "AR": 37, 
        "GALA": 38, "FTM": 39, "BONK": 40, "FLOKI": 41, "JUP": 42, "DYDX": 43, 
        "STRK": 44, "PYTH": 45, "JTO": 46, "ONDO": 47
    };

    let balances = new Array(accounts.length).fill(0);
    let negativePnLs = new Array(accounts.length).fill(0);
    
    // Новые массивы для хранения объемов (Value) с плечом
    let longValues = new Array(accounts.length).fill(0);
    let shortValues = new Array(accounts.length).fill(0);

    let isHidden = false;

    // SVG иконки стрелок
    const longArrowSVG = '<polygon points="8,2 14,14 2,14"/>'; // Вверх
    const shortArrowSVG = '<polygon points="2,2 14,2 8,14"/>'; // Вниз

    function toggleBalances() {
        isHidden = !isHidden;
        
        const btn = document.getElementById('toggle-balance-btn');
        const btnText = document.getElementById('btn-text');
        
        if (isHidden) {
            btn.classList.add('active');
            btnText.innerText = "Показать баланс";
        } else {
            btn.classList.remove('active');
            btnText.innerText = "Скрыть баланс";
        }
        
        updateGrandTotals();
    }

    function renderUI() {
        const container = document.getElementById('wallets-container');
        container.innerHTML = ''; 

        accounts.forEach((account, index) => {
            const shortAddress = account.address.slice(0,6) + '...' + account.address.slice(-4);
            container.innerHTML += `
                <div class="wallet-card neumorphic" id="card-${index}">
                    <div class="wallet-info">
                        <div class="wallet-name" title="${account.name}">${account.name}</div>
                        <div class="wallet-address">${shortAddress}</div>
                        <div class="wallet-balance" id="balance-${index}">...</div>
                    </div>
                    
                    <div class="divider"></div>
                    
                    <div class="wallet-positions neumorphic-inset">
                        <table>
                            <thead>
                                <tr>
                                    <th class="direction-header"></th>
                                    <th>Токен</th>
                                    <th>Вход</th>
                                    <th style="text-align: right;">PNL</th>
                                </tr>
                            </thead>
                            <tbody id="positions-${index}">
                                <tr><td colspan="4" class="no-positions">Загрузка...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            `;
        });
    }

    function updateGrandTotals() {
        const currentCapital = balances.reduce((acc, curr) => acc + curr, 0);
        const totalDrawdown = negativePnLs.reduce((acc, curr) => acc + curr, 0);
        const potentialCapital = currentCapital + Math.abs(totalDrawdown);
        
        // Подсчет общих объемов
        const totalLongs = longValues.reduce((acc, curr) => acc + curr, 0);
        const totalShorts = shortValues.reduce((acc, curr) => acc + curr, 0);

        // Обновление основных сумм
        document.getElementById('grand-total').innerText = isHidden ? '***' : `$${currentCapital.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
        document.getElementById('potential-total').innerText = isHidden ? '***' : `$${potentialCapital.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
        document.getElementById('drawdown-sum').innerText = isHidden ? 'Сумма минусов: ***' : `Сумма минусов: -$${Math.abs(totalDrawdown).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
        
        // Обновление объемов лонгов и шортов
        document.getElementById('total-long-value').innerText = isHidden ? '***' : `$${totalLongs.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
        document.getElementById('total-short-value').innerText = isHidden ? '***' : `$${totalShorts.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
    }

    function renderLivePrices(livePricesMap) {
        const container = document.getElementById('prices-container');
        
        const coins = Object.keys(livePricesMap).sort((a, b) => {
            const rankA = mktCapRanks[a] || 999;
            const rankB = mktCapRanks[b] || 999;
            if (rankA === rankB) { return a.localeCompare(b); }
            return rankA - rankB;
        });

        if (coins.length === 0) {
            container.innerHTML = '<span class="no-positions">Нет активных торговых пар</span>';
            return;
        }

        let html = '';
        coins.forEach(coin => {
            let price = livePricesMap[coin];
            let decimals = price < 10 ? 4 : 2; 
            let formattedPrice = price.toLocaleString('en-US', {minimumFractionDigits: decimals, maximumFractionDigits: decimals});
            
            html += `
                <div class="price-pill neumorphic-inset">
                    <span class="price-coin">${coin}</span>
                    <span class="price-value">$${formattedPrice}</span>
                </div>
            `;
        });
        
        container.innerHTML = html;
    }

    function equalizeCardHeights() {
        const cards = document.querySelectorAll('.wallet-card');
        cards.forEach(card => card.style.height = 'auto');
        
        let maxHeight = 0;
        cards.forEach(card => {
            const cardHeight = card.offsetHeight;
            if (cardHeight > maxHeight) maxHeight = cardHeight;
        });

        const targetHeight = maxHeight * 1.1;
        cards.forEach(card => card.style.height = `${targetHeight}px`);
    }

    async function fetchWalletData(account, index) {
        let walletLivePrices = {};

        try {
            // Магический запрос webData2, который видит всё (фьючи, спот и копитрейдинг) за 1 раз
            const response = await fetch('https://api.hyperliquid.xyz/info', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ type: "webData2", user: account.address })
            });

            const webData = await response.json();
            
            // 1. ФЬЮЧЕРСНЫЙ БАЛАНС (уже включает в себя открытые позиции и PnL)
            let perpValue = 0;
            if (webData.clearinghouseState && webData.clearinghouseState.marginSummary) {
                perpValue = parseFloat(webData.clearinghouseState.marginSummary.accountValue) || 0;
            }
            
            // 2. СПОТОВЫЙ БАЛАНС (ищем заначку в USDC)
            let spotUsdcValue = 0;
            if (webData.spotState && webData.spotState.balances) {
                const usdcToken = webData.spotState.balances.find(b => b.coin === "USDC");
                if (usdcToken) {
                    spotUsdcValue = parseFloat(usdcToken.total) || 0;
                }
            }

            // 3. КОПИТРЕЙДИНГ (Vaults)
            const vaultValue = parseFloat(webData.totalVaultEquity) || 0;

            // --- ИТОГОВЫЙ БАЛАНС: Складываем 3 корзины вместе ---
            const totalAccountValue = perpValue + spotUsdcValue + vaultValue; 
            
            balances[index] = totalAccountValue; 
            document.getElementById(`balance-${index}`).innerText = `$${totalAccountValue.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;

            // Отрисовка позиций (они лежат внутри фьючерсной корзины - clearinghouseState)
            const positions = (webData.clearinghouseState && webData.clearinghouseState.assetPositions) ? webData.clearinghouseState.assetPositions : [];
            
            let tableHtml = "";
            let walletNegativePnL = 0; 
            let accLongValue = 0;
            let accShortValue = 0;

            if (positions.length === 0) {
                tableHtml = `<tr><td colspan="4" class="no-positions">Нет позиций</td></tr>`;
            } else {
                positions.forEach(posInfo => {
                    const pos = posInfo.position;
                    const coin = pos.coin;
                    const entryPrice = parseFloat(pos.entryPx);
                    const pnl = parseFloat(pos.unrealizedPnl);
                    const size = parseFloat(pos.szi); 
                    const posValue = parseFloat(pos.positionValue); 

                    const currentMarkPrice = entryPrice + (pnl / size);
                    walletLivePrices[coin] = currentMarkPrice;

                    if (pnl < 0) walletNegativePnL += pnl;

                    const isLong = size > 0;
                    const isShort = size < 0;
                    
                    if (isLong) accLongValue += posValue;
                    else if (isShort) accShortValue += posValue;

                    const pnlClass = pnl >= 0 ? 'pnl-green' : 'pnl-red';
                    const pnlSign = pnl >= 0 ? '+' : '';

                    let directionHtml = "";
                    if (isLong) {
                        directionHtml = `<svg class="direction-icon long-icon" viewBox="0 0 16 16">${longArrowSVG}</svg>`;
                    } else if (isShort) {
                        directionHtml = `<svg class="direction-icon short-icon" viewBox="0 0 16 16">${shortArrowSVG}</svg>`;
                    }

                    tableHtml += `
                        <tr>
                            <td class="direction-cell">${directionHtml}</td>
                            <td style="font-weight: bold;">${coin}</td>
                            <td>$${entryPrice.toLocaleString('en-US', {minimumFractionDigits: 0, maximumFractionDigits: 2})}</td>
                            <td class="${pnlClass}" style="text-align: right;">${pnlSign}$${pnl.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}</td>
                        </tr>
                    `;
                });
            }

            negativePnLs[index] = walletNegativePnL;
            longValues[index] = accLongValue;
            shortValues[index] = accShortValue;
            
            document.getElementById(`positions-${index}`).innerHTML = tableHtml;

        } catch (error) {
            console.error(`Ошибка загрузки ${account.name}:`, error);
            document.getElementById(`positions-${index}`).innerHTML = `<tr><td colspan="4" class="no-positions pnl-red">Ошибка</td></tr>`;
        }

        updateGrandTotals();
        return walletLivePrices;
    }

    async function updateAllWallets() {
        const fetchPromises = accounts.map((account, index) => fetchWalletData(account, index));
        const results = await Promise.all(fetchPromises);
        
        let globalLivePrices = {};
        results.forEach(walletPrices => {
            if(walletPrices) {
                Object.assign(globalLivePrices, walletPrices);
            }
        });

        equalizeCardHeights();
        renderLivePrices(globalLivePrices); 
    }

    renderUI();
    updateAllWallets();
    setInterval(updateAllWallets, 15000); 

</script>

</body>
</html>
